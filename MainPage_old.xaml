<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Water_reminder.MainPage"
             BackgroundColor="#0F1724"
             xmlns:vm="clr-namespace:Hydra.Presentation.ViewModels">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Text="Hydra" FontSize="28" TextColor="White" />

        <Frame Grid.Row="1" CornerRadius="24" BackgroundColor="#0B1220" Padding="20">
            <StackLayout Spacing="18" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="Today" TextColor="#8EA3BF" FontSize="14" />
                <Label Text="{Binding ProgressText}" TextColor="White" FontSize="22" HorizontalOptions="Center" />

                <ProgressBar x:Name="ProgressBar" Progress="0.5" HeightRequest="12" BackgroundColor="#0A2433" ProgressColor="#40C4FF" CornerRadius="6"/>

                <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                    <Button Text="+100ml" Command="{Binding Add100Command}" CornerRadius="20" BackgroundColor="#122F4A" TextColor="White" />
                    <Button Text="+250ml" Command="{Binding Add250Command}" CornerRadius="20" BackgroundColor="#122F4A" TextColor="White" />
                    <Button Text="+500ml" Command="{Binding Add500Command}" CornerRadius="20" BackgroundColor="#122F4A" TextColor="White" />
                    <Button Text="+1L" Command="{Binding Add1000Command}" CornerRadius="20" BackgroundColor="#122F4A" TextColor="White" />
                </StackLayout>

            </StackLayout>
        </Frame>

        <Button Grid.Row="2" Text="Quick Add" HorizontalOptions="Fill" CornerRadius="28" HeightRequest="56" BackgroundColor="#1E90FF" TextColor="White" Command="{Binding Add250Command}"/>

    </Grid>

</ContentPage>
