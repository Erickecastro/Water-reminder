<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Water_reminder.LoginPage"
             BackgroundColor="{AppThemeBinding Light=#F4F8FF, Dark={StaticResource AppBackground}}">

    <Grid RowDefinitions="300,*">

        <Grid x:Name="TopHero"
              Grid.Row="0"
              BackgroundColor="{StaticResource Primary}">

            <Image Source="login_wave.svg"
                   Aspect="AspectFill"
                   Opacity="0.35"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />

            <VerticalStackLayout VerticalOptions="Center"
                                 Padding="32,28,32,78"
                                 Spacing="14">

                <Label Text="Hydra"
                       FontSize="42"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />

                <Label Text="Hidratação inteligente,&#10;no seu ritmo."
                       FontSize="16"
                       TextColor="#EAF3FF"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Grid>


        <ScrollView Grid.Row="1"
                    Margin="0,-78,0,0">

            <Border x:Name="LoginCard"
                    Margin="22,0,22,28"
                    Padding="26,30"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    Stroke="{AppThemeBinding Light=#E6ECF5, Dark=#263244}"
                    StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="34" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.14"
                            Radius="24"
                            Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="22">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Entrar"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Acesse para acompanhar sua hidratação diária"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark={StaticResource TextSecondary}}"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Modo teste: nome, e-mail e senha não são salvos."
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextColor="{AppThemeBinding Light=#7C8AA5, Dark={StaticResource TextSecondary}}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>


                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nome"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#4B5563, Dark={StaticResource TextSecondary}}" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1220}"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#253044}"
                                    StrokeThickness="1"
                                    Padding="14,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Entry Placeholder="Seu nome"
                                       Text="{Binding Name}"
                                       HeightRequest="50"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                       PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                            </Border>
                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="6">
                            <Label Text="E-mail"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#4B5563, Dark={StaticResource TextSecondary}}" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1220}"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#253044}"
                                    StrokeThickness="1"
                                    Padding="14,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Entry Placeholder="seu@email.com"
                                       Keyboard="Email"
                                       Text="{Binding Email}"
                                       HeightRequest="50"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                       PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                            </Border>
                        </VerticalStackLayout>


                        <VerticalStackLayout Spacing="6">
                            <Label Text="Senha"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#4B5563, Dark={StaticResource TextSecondary}}" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1220}"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#253044}"
                                    StrokeThickness="1"
                                    Padding="14,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <Entry Placeholder="Sua senha"
                                       IsPassword="True"
                                       Text="{Binding Password}"
                                       HeightRequest="50"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                       PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>


                    <Label Text="{Binding ErrorMessage}"
                           FontSize="12"
                           TextColor="#EF4444"
                           HorizontalTextAlignment="Center" />


                    <Button x:Name="LoginButton"
                            Text="Continuar"
                            HeightRequest="56"
                            CornerRadius="18"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            Command="{Binding SignInCommand}" />

                </VerticalStackLayout>

            </Border>
        </ScrollView>

    </Grid>
</ContentPage>