<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Water_reminder.LoginPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource AppBackground}}">

    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="TopHero" HeightRequest="260">
            <Image Source="login_wave.svg" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
            <VerticalStackLayout VerticalOptions="End" Padding="28,0,28,36" Spacing="6">
                <Label Text="Hydra" FontSize="38" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Hidratação inteligente, no seu ritmo."
                       FontSize="14"
                       TextColor="#E8F2FF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="LoginCard" Padding="24,8,24,28" Spacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Entrar" FontSize="30" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                    <BoxView HeightRequest="3" WidthRequest="42" Color="{StaticResource Primary}" HorizontalOptions="Start" CornerRadius="2" />
                    <Label Text="Modo teste: nome, e-mail e senha não são salvos."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nome" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                        <Entry Placeholder="Seu nome" Text="{Binding Name}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardBorder}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-mail" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                        <Entry Placeholder="seu@email.com" Keyboard="Email" Text="{Binding Email}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardBorder}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Senha" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                        <Entry Placeholder="Sua senha" IsPassword="True" Text="{Binding Password}" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardBorder}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#D74646" />

                <Button x:Name="LoginButton"
                        Text="Continuar"
                        HeightRequest="54"
                        CornerRadius="27"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        Command="{Binding SignInCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
