<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Water_reminder.Controls"
    x:Class="Water_reminder.LoginPage"
    BackgroundColor="#050509">

    <Grid>

        <controls:AuthBackgroundView />

        <Grid Padding="28">
            <Border
                WidthRequest="318"
                Padding="28,26"
                Stroke="#6A8CA8C8"
                StrokeThickness="1.3"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D20B1030" Offset="0" />
                        <GradientStop Color="#B8070A22" Offset="0.55" />
                        <GradientStop Color="#D0162448" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="38" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.56" Radius="34" Offset="0,18" />
                </Border.Shadow>

                <Grid>
                    <VerticalStackLayout
                        x:Name="LoginContent"
                        Spacing="14">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Entrar"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="#F6F1F8"
                                HorizontalTextAlignment="Center" />
                            <Label
                                Text="Informe seus dados"
                                FontSize="13"
                                TextColor="#8E9BB9"
                                HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="11">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Nome" FontSize="12" TextColor="#A9B4CF" />
                                <controls:BorderlessEntry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Seu nome" PlaceholderColor="#687798" TextColor="#F6F1F8" BackgroundColor="Transparent" HeightRequest="34" ClearButtonVisibility="Never" />
                                <BoxView x:Name="NameLine" HeightRequest="1.4" Color="#35436B" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="E-mail" FontSize="12" TextColor="#A9B4CF" />
                                <controls:BorderlessEntry x:Name="EmailEntry" Text="{Binding Email}" Placeholder="seu@email.com" PlaceholderColor="#687798" TextColor="#F6F1F8" Keyboard="Email" BackgroundColor="Transparent" HeightRequest="34" ClearButtonVisibility="Never" />
                                <BoxView x:Name="EmailLine" HeightRequest="1.4" Color="#35436B" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Senha" FontSize="12" TextColor="#A9B4CF" />
                                <controls:BorderlessEntry x:Name="PasswordEntry" Text="{Binding Password}" Placeholder="Sua senha" PlaceholderColor="#687798" TextColor="#F6F1F8" IsPassword="True" BackgroundColor="Transparent" HeightRequest="34" ClearButtonVisibility="Never" />
                                <BoxView x:Name="PasswordLine" HeightRequest="1.4" Color="#35436B" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#FF8278" MinimumHeightRequest="14" HorizontalTextAlignment="Center" />

                        <Button
                            x:Name="LoginButton"
                            Text="Login"
                            HeightRequest="52"
                            CornerRadius="18"
                            BorderWidth="1"
                            BorderColor="#55607F"
                            BackgroundColor="#18141F42"
                            TextColor="#F6F1F8"
                            FontAttributes="Bold"
                            Command="{Binding SignInCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
