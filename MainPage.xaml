<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Water_reminder.Controls"
             x:Class="Water_reminder.MainPage"
             BackgroundColor="#050509">

    <Grid>
        <controls:AuthBackgroundView />

        <Grid RowDefinitions="*,Auto">
            <Grid Grid.Row="0" RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="12">
                <VerticalStackLayout x:Name="HeaderContainer" Grid.Row="0" HorizontalOptions="Center" Spacing="4">
                    <controls:AnimatedCupView x:Name="CupMascot" WidthRequest="92" HeightRequest="92" HorizontalOptions="Center" />
                    <Label Text="Hidrat&#xE9;" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="#F6F1F8" />
                </VerticalStackLayout>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout x:Name="ContentContainer" Spacing="12" Padding="0,0,0,14">
                        <Border Padding="16"
                                Stroke="#6A8CA8C8"
                                StrokeShape="RoundRectangle 22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D20B1030" Offset="0" />
                                    <GradientStop Color="#B8070A22" Offset="0.55" />
                                    <GradientStop Color="#D0162448" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.28" Radius="22" Offset="0,10" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="*,86" ColumnSpacing="16">
                                <VerticalStackLayout Grid.Column="0" Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Consumo de hoje"
                                               FontSize="13"
                                               TextColor="#8EA3BF" />
                                        <Label Text="{Binding ProgressText}" FontSize="24" FontAttributes="Bold"
                                               TextColor="#F6F1F8" />
                                    </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding ProgressPercent, StringFormat='{0:P0}'}"
                                               FontSize="28"
                                               FontAttributes="Bold"
                                               TextColor="#40C4FF"
                                               HorizontalTextAlignment="End"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="Meta" FontSize="12" TextColor="#8EA3BF" />
                                        <Label Text="{Binding DailyGoal, StringFormat='{0} ml'}" FontAttributes="Bold"
                                               TextColor="#F6F1F8" />
                                    </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Restante" FontSize="12"
                                               TextColor="#8EA3BF" />
                                        <Label Text="{Binding RemainingMl, StringFormat='{0} ml'}"
                                               FontAttributes="Bold"
                                               TextColor="#40C4FF" />
                                    </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <controls:HydrationProgressView
                                    x:Name="ProgressCup"
                                    Grid.Column="1"
                                    WidthRequest="64"
                                    HeightRequest="142"
                                    HorizontalOptions="End"
                                    Progress="{Binding ProgressPercent}" />
                            </Grid>
                        </Border>

                        <Border Padding="14"
                                Stroke="#6A8CA8C8"
                                StrokeShape="RoundRectangle 18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D20B1030" Offset="0" />
                                    <GradientStop Color="#B8070A22" Offset="0.55" />
                                    <GradientStop Color="#D0162448" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding StatusLabel}" FontAttributes="Bold" TextColor="#F6F1F8" />
                                <Label Text="{Binding MotivationMessage}" FontSize="13" TextColor="#B9AFC0" />
                                <Label Text="{Binding LastIntakeLabel}" FontSize="12" TextColor="#40C4FF" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="12"
                                Stroke="#6A8CA8C8"
                                StrokeShape="RoundRectangle 20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D20B1030" Offset="0" />
                                    <GradientStop Color="#B8070A22" Offset="0.55" />
                                    <GradientStop Color="#D0162448" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Adicionar rápido" FontAttributes="Bold" TextColor="#F6F1F8" />
                                    <Button Text="Zerar"
                                            Grid.Column="1"
                                            Command="{Binding ResetTodayCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="#8EA3BF"
                                            BorderColor="#35436B"
                                            BorderWidth="1"
                                            CornerRadius="16"
                                            HeightRequest="34"
                                            MinimumHeightRequest="34"
                                            FontSize="12"
                                            Padding="14,0"
                                            Pressed="OnActionPressed"
                                            Released="OnActionReleased" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                    <Button Style="{StaticResource QuickAddPillButton}"
                                            Text="+ 100 ml"
                                            Command="{Binding Add100Command}"
                                            Pressed="OnActionPressed"
                                            Released="OnActionReleased"
                                            Clicked="OnHydrationButtonClicked" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource QuickAddPillButton}"
                                            Text="+ 250 ml"
                                            Command="{Binding Add250Command}"
                                            Pressed="OnActionPressed"
                                            Released="OnActionReleased"
                                            Clicked="OnHydrationButtonClicked" />
                                    <Button Grid.Row="1"
                                            Style="{StaticResource QuickAddPillButton}"
                                            Text="+ 500 ml"
                                            Command="{Binding Add500Command}"
                                            Pressed="OnActionPressed"
                                            Released="OnActionReleased"
                                            Clicked="OnHydrationButtonClicked" />
                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource QuickAddPillButton}"
                                            Text="+ 1000 ml"
                                            Command="{Binding Add1000Command}"
                                            Pressed="OnActionPressed"
                                            Released="OnActionReleased"
                                            Clicked="OnHydrationButtonClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <controls:BottomNavBar Grid.Row="1"
                                   ActiveTab="Home"
                                   NavigateRequested="OnNavigateRequested" />
        </Grid>
    </Grid>
</ContentPage>
