<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Water_reminder.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource AppBackground}}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="14">
        <VerticalStackLayout x:Name="HeaderContainer" Grid.Row="0" HorizontalOptions="Center" Spacing="6">
            <Image Source="copoagua.png" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center" />
            <Label Text="Hydra" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
            <Label Text="Seu plano de hidratação" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ContentContainer" Spacing="14">
                <Border Padding="20" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout>
                                <Label Text="Consumo de hoje" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                                <Label Text="{Binding ProgressText}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                            </VerticalStackLayout>
                            <Border Padding="10,8" BackgroundColor="#22395A" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                                <Label Text="{Binding ProgressPercent, StringFormat='{0:P0}'}" TextColor="{StaticResource AccentBlue}" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <ProgressBar Progress="{Binding ProgressPercent}" HeightRequest="8" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="Meta" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding DailyGoal, StringFormat='{0} ml'}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout HorizontalOptions="End">
                                <Label Text="Restante" FontSize="12" HorizontalTextAlignment="End" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding RemainingMl, StringFormat='{0} ml'}" HorizontalTextAlignment="End" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding StatusLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                        <Label Text="{Binding MotivationMessage}" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                        <Label Text="{Binding LastIntakeLabel}" FontSize="12" TextColor="{StaticResource AccentBlue}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Adicionar rápido" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Button Grid.Row="0" Grid.Column="0" Text="+100 ml" Command="{Binding Add100Command}" />
                            <Button Grid.Row="0" Grid.Column="1" Text="+250 ml" Command="{Binding Add250Command}" />
                            <Button Grid.Row="1" Grid.Column="0" Text="+500 ml" Command="{Binding Add500Command}" />
                            <Button Grid.Row="1" Grid.Column="1" Text="+1000 ml" Command="{Binding Add1000Command}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="PrimaryActionButton"
                Grid.Row="2"
                Text="Registrar 250 ml"
                Command="{Binding Add250Command}"
                HeightRequest="56"
                CornerRadius="28"
                FontAttributes="Bold"/>
    </Grid>
</ContentPage>
