<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Water_reminder.Controls"
    x:Class="Water_reminder.WelcomePage"
    BackgroundColor="#050509">

    <Grid>
        <controls:AuthBackgroundView />

        <Grid
            Padding="0"
            RowDefinitions="Auto,*">

            <Grid
                x:Name="WelcomeContent"
                Grid.Row="0"
                Padding="40,116,40,0"
                HorizontalOptions="Fill"
                RowDefinitions="Auto,Auto"
                RowSpacing="16">
                <Border
                    Grid.Row="0"
                    Padding="18,8"
                    BackgroundColor="#26080B22"
                    HorizontalOptions="Center"
                    Stroke="#4562869A"
                    StrokeThickness="1.2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            Text="Hidraté"
                            FontFamily="Cascadia Code"
                            FontSize="38"
                            TextColor="#F6F1F8"
                            VerticalTextAlignment="Center"
                            LineBreakMode="NoWrap" />
                    </HorizontalStackLayout>
                </Border>
                <Label
                    Grid.Row="1"
                    Text="Dizer que esqueceu de beber &#xE1;gua&#10;n&#xE3;o ser&#xE1; mais desculpa!"
                    FontSize="18"
                    TextColor="#B9AFC0"
                    HorizontalTextAlignment="Center"
                    LineHeight="1.18" />
            </Grid>

            <Border
                x:Name="WaterBadge"
                Grid.Row="1"
                WidthRequest="304"
                Padding="34,30"
                Stroke="#6A8CA8C8"
                StrokeThickness="1.3"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,92">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D20B1030" Offset="0" />
                        <GradientStop Color="#B8070A22" Offset="0.55" />
                        <GradientStop Color="#D0162448" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="44" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.55" Radius="34" Offset="0,18" />
                </Border.Shadow>

                <Grid>
                    <VerticalStackLayout Spacing="24" VerticalOptions="Center">
                        <Button
                            x:Name="ContinueButton"
                            Text="Entrar"
                            HeightRequest="58"
                            CornerRadius="18"
                            BorderWidth="1"
                            BorderColor="#55607F"
                            BackgroundColor="#18141F42"
                            TextColor="#E7E5EE"
                            FontAttributes="Bold"
                            FontSize="18"
                            Clicked="OnContinueClicked" />

                        <Button
                            x:Name="ExitButton"
                            Text="Sair"
                            HeightRequest="48"
                            CornerRadius="18"
                            BorderWidth="1"
                            BorderColor="#6F2929"
                            BackgroundColor="#35100624"
                            TextColor="#E06F60"
                            FontAttributes="Bold"
                            FontSize="16"
                            Clicked="OnExitClicked" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
