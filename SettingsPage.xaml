<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Water_reminder.SettingsPage"
             Title="Configurações"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource AppBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Configurações" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />

            <Border Padding="16" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Meta diária (ml)" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                    <Label Text="{Binding DailyGoalMl, StringFormat='{0} ml'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                    <Slider Minimum="1000" Maximum="6000" Value="{Binding DailyGoalMl}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Lembretes" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" FontAttributes="Bold" />
                        <Label Text="Ativar lembretes de hidratação" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" />
                </Grid>
            </Border>

            <Border Padding="16" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tema" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Claro" Command="{Binding ToggleThemeCommand}" CommandParameter="light" />
                        <Button Text="Escuro" Command="{Binding ToggleThemeCommand}" CommandParameter="dark" />
                        <Button Text="Sistema" Command="{Binding ToggleThemeCommand}" CommandParameter="system" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Salvar alterações" Command="{Binding SaveCommand}" HeightRequest="52" CornerRadius="26" />
            <Label Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
