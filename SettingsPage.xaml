<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Water_reminder.Controls"
             x:Class="Water_reminder.SettingsPage"
             Title="Configura&#xE7;&#xF5;es"
             BackgroundColor="#050509">

    <Grid>
        <controls:AuthBackgroundView />

        <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout x:Name="ContentContainer" Padding="20" Spacing="16">
                    <Label Text="Configura&#xE7;&#xF5;es" FontSize="26" FontAttributes="Bold" TextColor="#F6F1F8" />

                    <Border Padding="16"
                            Stroke="{AppThemeBinding Light=#D9E4F2, Dark=#6A8CA8C8}"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D20B1030" Offset="0" />
                                <GradientStop Color="#B8070A22" Offset="0.55" />
                                <GradientStop Color="#D0162448" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Perfil" FontAttributes="Bold" TextColor="#F6F1F8" />
                                <Label Text="Dados salvos neste dispositivo." FontSize="12" TextColor="#B9AFC0" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Nome" FontSize="12" TextColor="#A9B4CF" />
                                <controls:BorderlessEntry Text="{Binding AccountName}" Placeholder="Seu nome" PlaceholderColor="#687798" TextColor="#F6F1F8" BackgroundColor="Transparent" ClearButtonVisibility="Never" />
                                <BoxView HeightRequest="1" Color="#35436B" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="E-mail" FontSize="12" TextColor="#A9B4CF" />
                                <controls:BorderlessEntry Text="{Binding AccountEmail}" Placeholder="seu@email.com" PlaceholderColor="#687798" TextColor="#F6F1F8" Keyboard="Email" BackgroundColor="Transparent" ClearButtonVisibility="Never" />
                                <BoxView HeightRequest="1" Color="#35436B" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Senha" FontSize="12" TextColor="#A9B4CF" />
                                <controls:BorderlessEntry Text="{Binding AccountPassword}" Placeholder="Nova senha" PlaceholderColor="#687798" TextColor="#F6F1F8" IsPassword="True" BackgroundColor="Transparent" ClearButtonVisibility="Never" />
                                <BoxView HeightRequest="1" Color="#35436B" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Stroke="{AppThemeBinding Light=#D9E4F2, Dark=#6A8CA8C8}"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D20B1030" Offset="0" />
                                <GradientStop Color="#B8070A22" Offset="0.55" />
                                <GradientStop Color="#D0162448" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Meta di&#xE1;ria (ml)" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                            <Label Text="{Binding DailyGoalMl, StringFormat='{0} ml'}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource AccentBlue}" />
                            <Slider Minimum="1000" Maximum="6000" Value="{Binding DailyGoalMl}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16"
                            Stroke="{AppThemeBinding Light=#D9E4F2, Dark=#6A8CA8C8}"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D20B1030" Offset="0" />
                                <GradientStop Color="#B8070A22" Offset="0.55" />
                                <GradientStop Color="#D0162448" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Lembretes" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" FontAttributes="Bold" />
                                <Label Text="Ativar lembretes de hidrata&#xE7;&#xE3;o" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" />
                        </Grid>
                    </Border>

                    <Button Text="Salvar altera&#xE7;&#xF5;es"
                            Command="{Binding SaveCommand}"
                            HeightRequest="52"
                            CornerRadius="26"
                            Pressed="OnActionPressed"
                            Released="OnActionReleased" />

                    <Label Text="{Binding StatusMessage}" TextColor="#B9AFC0" HorizontalTextAlignment="Center" />

                    <Border Padding="16"
                            Stroke="{AppThemeBinding Light=#D9E4F2, Dark=#6A8CA8C8}"
                            StrokeShape="RoundRectangle 16"
                            Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D20B1030" Offset="0" />
                                <GradientStop Color="#B8070A22" Offset="0.55" />
                                <GradientStop Color="#D0162448" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Conta" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                            <Label Text="Sair e voltar para a tela de login." FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource TextSecondary}}" />
                            <Button Text="Sair da conta"
                                    Command="{Binding LogoutCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#D74646"
                                    BorderColor="#D74646"
                                    BorderWidth="1"
                                    CornerRadius="22"
                                    HeightRequest="46"
                                    Pressed="OnActionPressed"
                                    Released="OnActionReleased" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <controls:BottomNavBar Grid.Row="1"
                                   ActiveTab="Settings"
                                   NavigateRequested="OnNavigateRequested" />
        </Grid>
    </Grid>
</ContentPage>
