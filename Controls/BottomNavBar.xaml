<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Water_reminder.Controls.BottomNavBar"
    x:Name="Root">

    <Border
        Margin="20,0,20,18"
        Padding="12,8"
        BackgroundColor="{AppThemeBinding Light=#EFFFFFFF, Dark=#D8080B22}"
        Stroke="{AppThemeBinding Light=#D9E4F2, Dark=#4562869A}"
        StrokeThickness="1.2"
        HorizontalOptions="Fill"
        VerticalOptions="End">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="26" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#000000" Opacity="0.25" Radius="24" Offset="0,10" />
        </Border.Shadow>

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border x:Name="HomeItem" Grid.Column="0" Padding="0,9" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="HomeIcon" Text="&#x2302;" FontSize="22" HorizontalTextAlignment="Center" />
                    <Label x:Name="HomeText" Text="Hoje" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="HistoryItem" Grid.Column="1" Padding="0,9" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="HistoryIcon" Text="&#x25F7;" FontSize="22" HorizontalTextAlignment="Center" />
                    <Label x:Name="HistoryText" Text="Hist&#xF3;rico" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistoryTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="SettingsItem" Grid.Column="2" Padding="0,9" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="SettingsIcon" Text="&#x25CE;" FontSize="22" HorizontalTextAlignment="Center" />
                    <Label x:Name="SettingsText" Text="Ajustes" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>
