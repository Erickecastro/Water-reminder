<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Water_reminder.Controls"
    x:Class="Water_reminder.MainContainerPage"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ContentView
            x:Name="ContentHost"
            Grid.Row="0"/>

        <controls:BottomNavBar
            x:Name="BottomNavigation"
            Grid.Row="1"
            ActiveTab="Home"
            NavigateRequested="OnNavigateRequested"/>

    </Grid>

</ContentPage>